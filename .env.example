# AngelOne SmartAPI Credentials
# Add your details here (keep this file private or set via Render Environment Variables)

SMARTAPI_API_KEY=your_angelone_api_key_here
SMARTAPI_CLIENT_CODE=your_client_code_here
SMARTAPI_PIN=your_4_digit_mpin_here
SMARTAPI_TOTP_KEY=your_totp_secret_key_here

# Server Port (Default: 3000 or assigned by cloud host)
PORT=3000
